  },
  "homepage": "https://github.com/zFl4wless/wakatime-discord-bot#readme",
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "axios": "^1.3.2",
    "color-util-nodejs": "^1.0.2",
    "discord.js": "^14.7.1",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "glob": "^11.0.3",
    "libsodium-wrappers-sumo": "^0.7.13",
    "qs": "^6.11.0",
    "quickchart-js": "^3.1.3",
    "tslog": "^4.7.2"
  },
