    "@types/libsodium-wrappers-sumo": "^0.7.8",
    "@types/node": "^24.5.2",
    "@types/node-cron": "^3.0.11",
    "@types/qs": "^6.9.7",
    "prisma": "^6.16.2",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.2"
  }
