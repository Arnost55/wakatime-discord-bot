# Bot
BOT_TOKEN=YourBotToken
GUILD_ID=YourGuildId

# Database
DATABASE_URL="postgresql://janedoe:mypassword@localhost:5432/mydb?schema=public"

# API
API_URL=YourApiUrl
API_PORT=3000

# WakaTime
CLIENT_ID=YourWakaTimeClientId
CLIENT_SECRET=YourWakaTimeClientSecret
WAKATIME_BASE_URL=https://wakatime.com

# Custom WakaTime forks (optional)
# Define short names for WakaTime-compatible API instances.
# Users can then use the short name in /authorize and /account add commands.
# Examples:
# WAKATIME_FORK_HAKATIME=https://hakatime.example.com
# WAKATIME_FORK_WAKAPI=https://wakapi.example.com
# WAKATIME_FORK_WAKATIME=https://wakatime.com  # Built-in; overrides default

# Crypto
CRYPTO_PASSWORD=YourSecurePassword